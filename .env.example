# Copy to .env and adjust values before running: docker compose up --build
#
# Sensitive credentials (JWT, SQL SA password, SMTP) are loaded from Docker Secrets.
# Copy example secret files first:
#   mkdir -p secrets && cp secrets.example/* secrets/

# Non-secret configuration
JWT_VALID_ISSUER=medical-center
JWT_VALID_AUDIENCE=medical-center-client

# Public URLs (browser-reachable from host machine)
API_PUBLIC_URL=/api
YARP_HOST_PORT=8080
FRONTEND_HOST_PORT=8081

# Optional OAuth (required only for Google login flows)
GOOGLE_AUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_AUTH_CLIENT_SECRET=replace-with-google-client-secret

# Local development without Docker Secrets (fallback env vars — uncomment if needed)
# MSSQL_SA_PASSWORD=
# JWT_SECRET=
# SMTP_EMAIL_USERNAME=
# SMTP_EMAIL_PASSWORD=
