# Copy to .env and adjust values before running: docker compose up --build
#
# Sensitive credentials (JWT, SQL SA password, SMTP, Google OAuth) are loaded from Docker Secrets.
# Copy example secret files first:
#   mkdir -p secrets && cp secrets.example/* secrets/

# Non-secret configuration
JWT_VALID_ISSUER=medical-center
JWT_VALID_AUDIENCE=medical-center-client

# Public URLs (browser-reachable from host machine)
API_PUBLIC_URL=/api
YARP_HOST_PORT=8080
FRONTEND_HOST_PORT=8081
FRONTEND_BASE_URL=http://localhost:8081

# CORS allowed origins (indexed env vars map to CorsSettings__AllowedOrigins__N)
# Comma-separated list for reference when configuring staging/production:
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:4200
CORS_ALLOWED_ORIGINS_0=http://localhost:8081
CORS_ALLOWED_ORIGINS_1=http://localhost:4200

# --- Local email capture (MailHog — active in docker-compose.yml) ---
# The mailhog service is part of the default compose stack (SMTP :1025, web UI :8025).
# The api service depends on mailhog (service_healthy) and routes outbound email via:
#   SmtpSettings__Host=mailhog, SmtpSettings__Port=1025, SmtpSettings__UseTls=false
# View captured messages at http://localhost:8025 after register/reset/appointment flows.
# Verify MailHog is up: ./scripts/mailhog-smoke.sh

# --- Staging email capture (Forge IDP SMTP) ---
# Staging ECS deploy injects IDP SMTP via .forge/pipeline.yaml pipeline secrets.
# For local validation of staging wiring: cp .env.staging.example .env.staging
# then: docker compose -f docker-compose.yml -f docker-compose.staging.yml up --build
# See docs/email-strategy.md for the dual MailHog (local) / IDP SMTP (staging) strategy.
# IDP_SMTP_HOST, IDP_SMTP_PORT, IDP_SMTP_USE_TLS, IDP_SMTP_USERNAME, IDP_SMTP_PASSWORD
# are managed as Forge pipeline secrets — never commit real values.

# Local development without Docker Secrets (fallback env vars — uncomment if needed)
# MSSQL_SA_PASSWORD=
# JWT_SECRET=
# SMTP_EMAIL_USERNAME=
# SMTP_EMAIL_PASSWORD=
