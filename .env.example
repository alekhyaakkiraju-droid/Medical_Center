# Copy to .env and adjust values before running: docker compose up --build

# SQL Server
MSSQL_SA_PASSWORD=ChangeMe_StrongPassword123!

# JWT (minimum 32 characters recommended)
JWT_SECRET=ChangeMe_UseAtLeast32CharactersForJwtSecret!
JWT_VALID_ISSUER=medical-center
JWT_VALID_AUDUENCE=medical-center-client

# Public URLs (browser-reachable from host machine)
API_PUBLIC_URL=http://localhost:8080/api
YARP_HOST_PORT=8080
FRONTEND_HOST_PORT=8081

# Optional OAuth (required only for Google login flows)
GOOGLE_AUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_AUTH_CLIENT_SECRET=replace-with-google-client-secret

# Optional SMTP (required only for email-sending flows)
SMTP_EMAIL_USERNAME=replace-with-smtp-username
SMTP_EMAIL_PASSWORD=replace-with-smtp-password
