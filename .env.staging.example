# Staging environment template (WO-031) — Forge IDP SMTP email capture.
# Copy to .env.staging and populate from Forge pipeline secrets / IDP console.
# Do NOT commit .env.staging (gitignored).

# Forge IDP SMTP relay (team-accessible email capture for UAT)
IDP_SMTP_HOST=smtp.idp.forge-platform.io
IDP_SMTP_PORT=587
IDP_SMTP_USE_TLS=true

# Injected by Forge Shipping pipeline secrets — never hardcode in git
IDP_SMTP_USERNAME=
IDP_SMTP_PASSWORD=

# IDP web UI for viewing captured staging emails (URL varies by tenant)
IDP_SMTP_WEB_URL=https://idp.forge-platform.io/smtp
