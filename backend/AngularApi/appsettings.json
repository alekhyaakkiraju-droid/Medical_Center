{
  "ConnectionStrings": {
    "connection": "Server=(localdb)\\mssqllocaldb;Database=MedicalCenter;Trusted_Connection=True;"
  },
  "AppSettings": {
    "FrontendUrl": "http://localhost:4200"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "ValidIssuer": "MedicalCenter",
    "ValidAudience": "MedicalCenterUsers",
    "Secret": "ReplaceWithAStrongSecretKeyInProduction",
    "AuthCookieName": "MedCenter.Auth",
    "RefreshCookieName": "MedCenter.Refresh",
    "CookiePath": "/api",
    "FrontendLoginSuccessUrl": "http://localhost:4200/auth/login-success"
  },
  "GoogleAuth": {
    "ClientId": "ReplaceWithGoogleClientId",
    "ClientSecret": "ReplaceWithGoogleClientSecret"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
