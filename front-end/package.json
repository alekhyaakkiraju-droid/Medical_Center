{
  "name": "medical-center",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run generate-api-types && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate-api-types": "bash ../scripts/generate-api-types.sh",
    "serve:ssr:MedicalCenter": "node dist/medical-center/server/server.mjs",
    "test:ci": "ng test --no-watch --browsers=ChromeHeadless",
    "lint:no-console": "node -e \"const{execSync}=require('child_process');const o=execSync('grep -rn \\\"console\\\\.\\\\(log\\\\|error\\\\)\\\" src/app --include=*.ts || true',{encoding:'utf8'});if(o.trim()){console.error(o);process.exit(1)}\"",
    "lint:placeholders": "bash ../scripts/check-public-placeholder-content.sh"
  },
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/localize": "^22.0.8",
    "@angular/material": "^22.0.6",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-browser-dynamic": "^22.0.8",
    "@angular/platform-server": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/ssr": "^22.0.8",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "apexcharts": "^4.4.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^3.7.1",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "flowbite": "^2.5.2",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "jwt-decode": "^4.0.0",
    "ngx-toastr": "^20.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@axe-core/cli": "^4.12.1",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.20.1",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.12.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
